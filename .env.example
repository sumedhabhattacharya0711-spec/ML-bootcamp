# Hugging Face token for speaker diarization (huggingface.co/settings/tokens, "read" access).
# Accept the conditions at https://huggingface.co/pyannote/speaker-diarization-community-1 once.
HF_TOKEN=
# Optional override (default: pyannote/speaker-diarization-community-1; pyannote/speaker-diarization-3.1 also works)
DIARIZATION_MODEL=
# Main LLM provider: Groq (key from console.groq.com)
LLM_API_KEY=
# Optional overrides (defaults: Groq's OpenAI-compatible URL, openai/gpt-oss-120b)
LLM_BASE_URL=
LLM_MODEL=
# Backup provider: Gemini (key from aistudio.google.com), used when Groq is rate limited or down
LLM_GEMINI_KEY=
# Optional override (default: gemini-2.5-flash; any model your key lists, e.g. gemini-flash-latest)
LLM_GEMINI_MODEL=
# Cache LLM answers by exact input so reruns are identical (0 = off)
LLM_CACHE=
